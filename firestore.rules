rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(currentUserPath())
        && get(currentUserPath()).data.role == 'admin'
        && get(currentUserPath()).data.status == 'active';
    }

    function validRole(role) {
      return role == 'admin' || role == 'user';
    }

    function validStatus(status) {
      return status == 'active' || status == 'disabled';
    }

    function validValuationStatus(status) {
      return status == 'pending'
        || status == 'completed'
        || status == 'deleted';
    }

    function validProgressStep(step) {
      return step is int && step >= 1 && step <= 14;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emailLower == request.auth.token.email.lower()
          && request.resource.data.role == 'user'
          && request.resource.data.status == 'active'
        )
        ||
        (
          isAdmin()
          && request.resource.data.uid == userId
          && validRole(request.resource.data.role)
          && request.resource.data.status == 'active'
        )
      );

      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email
          && request.resource.data.emailLower == resource.data.emailLower
        )
        ||
        (
          isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.emailLower == resource.data.emailLower
          && validRole(request.resource.data.role)
          && validStatus(request.resource.data.status)
        )
      );

      allow delete: if isAdmin();
    }

    function isActiveStaff() {
      return isSignedIn()
        && exists(currentUserPath())
        && get(currentUserPath()).data.get('status', 'active') == 'active'
        && validRole(get(currentUserPath()).data.get('role', 'user'));
    }

    function validActivo(data, activoId) {
      return data.keys().hasAll([
          'nombre', 'nombreBusqueda', 'categoria', 'propiedades',
          'tiposPiel', 'contraindicaciones', 'fotoUrl', 'fotoPath', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'nombre', 'nombreBusqueda', 'categoria', 'propiedades',
          'tiposPiel', 'contraindicaciones', 'fotoUrl', 'fotoPath', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 150
        && data.nombre.matches('.*[^\\s].*')
        && data.nombreBusqueda is string && data.nombreBusqueda.size() > 0
        && data.nombreBusqueda.size() <= 150
        && (
          // Compatibilidad con fichas y sesiones anteriores que usan texto.
          (data.categoria is string && data.categoria.size() > 0 && data.categoria.size() <= 100
            && data.categoria.matches('.*[^\\s].*'))
          || (data.categoria is list && data.categoria.size() > 0 && data.categoria.size() <= 18
            && data.categoria.toSet().size() == data.categoria.size()
            && data.categoria.hasOnly([
              'Hidratantes y humectantes', 'Exfoliantes', 'Despigmentantes',
              'Antioxidantes', 'Antiinflamatorios y calmantes', 'Seborreguladores',
              'Reparadores de la barrera cutánea', 'Oclusivos', 'Antiedad y reafirmantes',
              'Emolientes', 'Regeneradores y cicatrizantes', 'Queratolíticos',
              'Queratoplásticos', 'Antimicrobianos', 'Descongestivos',
              'Fotoprotectores', 'Tensores', 'Iluminadores'
            ]))
        )
        && data.propiedades is string && data.propiedades.size() > 0 && data.propiedades.size() <= 3000
        && data.propiedades.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.contraindicaciones is list && data.contraindicaciones.size() <= 20
        && data.contraindicaciones.join('').size() <= 10000
        && data.fotoUrl is string && data.fotoPath is string
        && (
          (data.fotoUrl == '' && data.fotoPath == '')
          || (
            data.fotoUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')
            && data.fotoUrl.size() <= 2048
            && data.fotoPath.matches('activos/[^/]+/' + activoId + '/[^/]+')
          )
        )
        && data.tiposPiel is list && data.tiposPiel.size() > 0 && data.tiposPiel.size() <= 6
        // Los nombres anteriores siguen admitidos para no romper sesiones abiertas.
        && data.tiposPiel.hasOnly(['Eudérmica', 'Alípica', 'Grasa', 'Grasa deshidratada', 'Sensible', 'Normal', 'Seca', 'Mixta', 'Madura'])
        && data.createdBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /activos/{activoId} {
      allow get, list: if isActiveStaff();
      allow create: if isActiveStaff()
        && validActivo(request.resource.data, activoId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isActiveStaff()
        && validActivo(request.resource.data, activoId)
        && (request.auth.uid == resource.data.createdBy || isAdmin())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /clientes/{clientId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn()
        && (
          (
            request.resource.data.createdBy == resource.data.createdBy
            && request.auth.uid == resource.data.createdBy
          )
          ||
          (
            isAdmin()
            && request.resource.data.createdBy == resource.data.createdBy
          )
        );

      allow delete: if isAdmin();
    }

    // REGLA PARA EL EXPEDIENTE COSMETOLÓGICO
    match /clientes/{clientId}/historiaClinica/{historyId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /valoraciones/{valuationId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validValuationStatus(request.resource.data.status)
        && validProgressStep(request.resource.data.currentStep)
        && request.resource.data.totalSteps == 14;

      allow update: if isSignedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.totalSteps == resource.data.totalSteps
        && validValuationStatus(request.resource.data.status)
        && validProgressStep(request.resource.data.currentStep)
        && (
          request.auth.uid == resource.data.createdBy
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    match /preregistros/{preRegistrationId} {
      allow get, list: if isSignedIn();
      allow create: if false;

      allow update: if isSignedIn()
        && resource.data.status == 'completed'
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'usedBy',
          'clientId',
          'valuationId',
          'usedAt',
          'updatedAt'
        ]);

      // La eliminación pasa por Cloud Functions para validar el rol y liberar
      // de forma atómica los identificadores de nombre y teléfono.
      allow delete: if false;
    }

    // Estos identificadores solo son administrados por Cloud Functions.
    match /preregistroIdentidades/{identityId} {
      allow read, write: if false;
    }
  }
}
